    <div class="slds-box slds-theme_default">
    <lightning:input name="firstNameInput" label="First Name" value="{!v.firstName}" />
            <lightning:input name="lastNameInput" label="Last Name" value="{!v.lastName}" />
            
            <lightning:input name="streetInput" label="Street" value="{!v.street}" />
            <lightning:input name="cityInput" label="City" value="{!v.city}" />
            <lightning:input name="stateInput" label="State" value="{!v.state}" />
            <lightning:input name="zipcodeInput" label="Zipcode" value="{!v.zipcode}" />
            
            <lightning:input type="number" name="paymentAmountInput" label="Payment Amount" value="{!v.paymentAmount}" />
            
