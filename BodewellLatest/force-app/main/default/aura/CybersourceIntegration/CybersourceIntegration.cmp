<aura:component controller="CybersourceIntegrationController" implements="lightning:isUrlAddressable" access="global">
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:attribute name="con" type="Contact" />
    <aura:attribute name="contactId" type="String" />
    <aura:attribute name="firstName" type="String" />
    <aura:attribute name="lastName" type="String" />
    <aura:attribute name="street" type="String" />
    <aura:attribute name="city" type="String" />
    <aura:attribute name="state" type="String" />
    <aura:attribute name="zipcode" type="String" />
    <aura:attribute name="paymentAmount" type="Integer" />
    
