<aura:component controller="URL_CreateRecordController" implements="flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction,lightning:actionOverride,lightning:isUrlAddressable" access="global" >
	<aura:attribute name="IsPhone" type="Boolean" default="{!$Browser.isPhone}" />
    <aura:handler name="change" value="{!v.pageReference}" action="{!c.doInit}"/>
    <aura:handler name="init" value="{!this}" action="{!c.onInit}"/>
</aura:component>