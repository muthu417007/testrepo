<aura:component implements="lightning:isUrlAddressable" access="global">
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:attribute name="conveyURL" type="String" />
    <aura:attribute name="trackingNumber" type="String" />
        
	<iframe width="100%" height="1000" style="" src="{!v.conveyURL}" />
</aura:component>