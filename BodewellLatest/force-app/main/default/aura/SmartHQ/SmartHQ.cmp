<aura:component controller = "WOSmartHQLink" implements="flexipage:availableForRecordHome,force:hasRecordId" access="global" >
	<aura:attribute name="recordId" type="Id" />
  	<aura:attribute name="WorkOrder" type="WorkOrder" />
    <aura:attribute name="Columns" type="List" />

    <aura:handler name="init" value="{!this}" action="{!c.myAction}" />

    <force:recordData aura:id="woRecord"
                  recordId="{!v.recordId}"
                  targetFields="{!v.WorkOrder}"
                  layoutType="FULL"
                  />

    <aura:iteration  items="{!v.WorkOrder}" var="WO">
       <a href="{!'geafs://newfi/?' +  WO.NewFI_Redirect_URL__c}" target="_blank">NewFI Link</a>
    </aura:iteration>
    
</aura:component>