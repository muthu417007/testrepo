<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <isExposed>true</isExposed>

    <masterLabel>BWC Cart Order Summary</masterLabel>

    <targets>

       <target>lightningCommunity__Page</target>

        <target>lightningCommunity__Default</target>

    </targets>

    <targetConfigs>

    <targetConfig targets="lightningCommunity__Default">

      <property label="Cart Data Binding" name="cart" type="String" default="{!Cart.Items}" />
      <property name="cartId" type="String" label="Id of the card" default="{!Cart.Details.cartId}" />
      <property label="Account Id" name="acctId" type="String" default="{!Cart.Details.accountId}" />
      <property label="Cart Status" name="cartStatus" type="String" default="{!Cart.Details.status}" />
       <property label="Total amount including discounts" name="cartProductAmountWithDiscount" type="String" default="{!Cart.Totals.productAmount}" />
      <property label="Total amount of promotion adjustments" name="cartPromotionAdjustmentTotal" type="String" default="{!Cart.Totals.promotionalAdjustmentAmount}" />
     
      

    </targetConfig>

  </targetConfigs>

</LightningComponentBundle>