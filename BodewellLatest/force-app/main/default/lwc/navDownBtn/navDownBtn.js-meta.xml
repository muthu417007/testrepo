<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Scroll Down</masterLabel>
    <description>Scrolls the user down to a specified Navigate To Component</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property type="String" name="label" label="Label" />
            <property type="String" name="navToName" label="Name of Navigate to Component" />  
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>