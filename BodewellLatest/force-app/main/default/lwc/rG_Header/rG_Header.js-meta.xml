<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>RG Header</masterLabel>
    <description>Header component for Repair GE Appliances.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property 
            name="menuName" 
            type="String" 
            datasource="apex://RG_NavigationLinkPickList" 
            label="Navigation Menu"
            description="The name of navigation menu on list"/>
            <property name="buttonlabel" type="String" label="Button Label" default="SCHEDULE SERVICE"/>
            <property name="redirectionLink" label="Button Redirection Link" type="String" description="Button Redirection Link"/>
            <property name="buttonArea" label="Button Area" type="String" description="Button Area" default="header" datasource="header,body,footer"/>
            <property type="ContentReference" name="imageiconid" label="Icon Image" filter="cms_image"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>