<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>RG Footer With Navigation Menu</masterLabel>
    <description>Footer With Navigation Menu Component for REGA</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property 
                name="menuName" 
                type="String" 
                datasource="apex://RG_NavigationLinkPickList" 
                label="Navigation Menu"
                description="The name of navigation menu on list"/>
            <property type="String" name="copyRightLabel" label="CopyRight Label" default="Copyright 2023"/>
            <property type="String" name="aboutGeLink" label="GE Appliances, a Haier company" default="https://www.geappliances.com"/>
            <property type="String" name="tradeMark" label="Trademark" default="GE is a trademark of the General Electric Company"/>
            <property type="String" name="lic" label="Liciense" default="Manufactured under trademark license."/>
            <property name="sectionId" type="String" label="Section ID" default="sectionId"/>
        </targetConfig>
   </targetConfigs>
</LightningComponentBundle>