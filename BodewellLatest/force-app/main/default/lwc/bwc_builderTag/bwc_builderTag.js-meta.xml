<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>BWC Tag</masterLabel>
    <description>Displays a Sale or Clearance tag</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property label="Product Data Binding" name="product" type="String" default="{!Product.Details}" />
            <property label="Sale Banner Color" name="saleBannerColor" type="Color" default="#acc37e" />
            <property label="Clearance Banner Color" name="clearanceBannerColor" type="Color" default="#12212e"/>
            <property label="User Buyer Groups" name="buyerGroupNames" type="String" default="{!User.Commerce.BuyerGroups}" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>