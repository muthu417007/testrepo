            <property name="RedirectionLink" label="RedirectionLink" type="String" default="RedirectionLink (**Only for Navigation Operation)" description="Redirection Link (**Only for Navigation Operation)"/>
            <property name="ButtonAlign" label="Button Align" type="String" default="Center" description="Button Align"  datasource="Left,Right,Center"/>
            <property name="ButtonStyle" label="ButtonStyle" type="String" default="StyleOne" description="Button Style"  datasource="StyleOne,StyleTwo,StyleThree"/>
            <property name="ButtonWidth" label="ButtonWidth( in rem)" type="Integer" description="Button width"/>
            <property name="ButtonMarginleft" label="Button Margin Left(in rem)" type="Integer" description="Button Margin From left (in rem)"/>
            <property name="ButtonMarginRight" label="Button Margin Right(in rem)" type="Integer" description="Button Margin From Right (in rem)"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>