<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>50.0</apiVersion>
    <isExposed>true</isExposed>

    <masterLabel>Contact Dashboard LWC Wrapper</masterLabel>
    <description>This is a LWC Wrapper for the Contact Dashboard VFP to be displayed in a Flow</description>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>

    <targetConfigs>

        <targetConfig targets="lightning__FlowScreen">
            <property name="contactId" type="String" label="ContactId" description="Id of Contact"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>