<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>RG Banner</masterLabel>
    <description>Banner Component for REGA</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property type="ContentReference" name="desktopimageId" label="Desktop Image" filter="cms_image"/>
            <property type="String" name="bannerheading" label="Heading"/>
            <property type="String" name="bannertext" label="Text"/>
            <property type="Integer" name="imageheight" label="Image Height(150-320)"/>
            <property type="ContentReference" name="mobileimageId" label="Mobile Image" filter="cms_image"/>
            <property type="Boolean" name="showStrip" label="Show Location Strip"/>
        </targetConfig>
   </targetConfigs>
</LightningComponentBundle>