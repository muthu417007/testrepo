<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property type="boolean" name="showImg" label="Show Image" default="true" description = "This option is use For Home Page"/>
            <property type="ContentReference" name="contentId" label="Select Image" filter="cms_image"/>
            <property type="boolean" name="showHeading" label="Show Heading" default="false" description = "This option is use For Resource Page"/>
            <property type="String" name="Heading" label="Enter Heading"/>
            <property type="String" name="richtext" label="Text"/>
            <property type="String" name="buttontext" label="Button Text"/>
            <property name="RedirectionLink" label="Redirection Link" type="String" />
            <property name="ButtonWidth" label="Button Width( in rem)" type="Integer" description="Button width"/>
        </targetConfig>
   </targetConfigs>
</LightningComponentBundle>