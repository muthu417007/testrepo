 <!--Heating and Air Conditioning Seasonal Performance Factor--->
    <hd>     
               <center><div style="color:#660033;font-weight:bold;font-family:'Arial Unicode MS';" > Heating and Air Conditioning Seasonal Performance Factor</div> </center>
    </hd>    
    <br/>
    <br/>
    <br/>
    <body>  
    <apex:pageBlock > 
    
    <br/>
        <apex:panelGrid columns="4" width="100%" border="1" cellspacing="0" cellpadding="0">
            <apex:panelGrid columns="4" bgcolor="#660033" columnClasses="colStyle" width="100%">
                <div style="color:#FFFAF0;font-weight:bold;" > Indoor Temperature</div> 
            </apex:panelGrid> 
            <apex:panelGrid columns="1">
                <hd> <b>65&#176;F</b></hd>            
            </apex:panelGrid>      
            <apex:panelGrid columns="1">
                <hd> <b>75&#176;F</b> </hd> 
            </apex:panelGrid>
            <apex:panelGrid columns="1">
               <hd>  <b> {!spf.X3rd_Temparature_HDN__c }&#176;F </b> </hd> 
            </apex:panelGrid>
            <apex:panelGrid columns="4" bgcolor="#660033" columnClasses="colStyle" width="100%">
                <div style="color:#FFFAF0;font-weight:bold;" > Annual KWH Required For Resistance Heat(KWH)</div>        
            </apex:panelGrid>
            <apex:panelGrid columns="1">         
                <apex:outputText value="{!spf.Annual_KWH_Required_For_Resistance_Ht65F__c }" />
            </apex:panelGrid>     
            <apex:panelGrid columns="1">
                <apex:outputText value="{!spf.Annual_KWH_Required_For_Resistance_Ht75F__c}" /> 
            </apex:panelGrid>
            <apex:panelGrid columns="1">
                <apex:outputText value="{!spf.Annual_KWH_Required_For_Resistance_Ht70F__c}" />
            </apex:panelGrid>
             <apex:panelGrid columns="4" bgcolor="#660033" columnClasses="colStyle" width="100%">
                <div style="color:#FFFAF0;font-weight:bold;" > Annual KWH Required For Heat Pump System</div>                 
            </apex:panelGrid>
            <apex:panelGrid columns="1">                   
                <apex:outputText value="{!spf.Annual_KWH_Required_For_Heat_Pump_Sys65F__c}" />
            </apex:panelGrid>
            <apex:panelGrid columns="1">
                <apex:outputText value="{!spf.Annual_KWH_Required_For_Heat_Pump_Sys75F__c}" /> 
            </apex:panelGrid>
            <apex:panelGrid columns="1">
                <apex:outputText value="{!spf.Annual_KWH_Required_For_Heat_Pump_Sys70F__c}" />
            </apex:panelGrid>
            <apex:panelGrid columns="4" bgcolor="#660033" columnClasses="colStyle" width="100%">
                <div style="color:#FFFAF0;font-weight:bold;" > Annual KWH Saved With Heat Pump System</div>      
            </apex:panelGrid>
            <apex:panelGrid columns="1">                
                <apex:outputText value="{!spf.Annual_KWH_Saved_With_Heat_Pump_Sys65F__c}" />
            </apex:panelGrid>
            <apex:panelGrid columns="1">
                <apex:outputText value="{!spf.Annual_KWH_Saved_With_Heat_Pump_Sys75F__c}" /> 
            </apex:panelGrid>
            <apex:panelGrid columns="1"> 
                <apex:outputText value="{!spf.Annual_KWH_Saved_With_Heat_Pump_Sys70F__c}" />
            </apex:panelGrid>
           
            <apex:panelGrid columns="4" bgcolor="#660033" columnClasses="colStyle" width="100%">
                <div style="color:#FFFAF0;font-weight:bold;" > SPF of Heat Pump</div>             
            </apex:panelGrid>
            <apex:panelGrid columns="1">                   
                <apex:outputText value="{!spf.SPF_of_Heat_Pump_65F__c}" />
            </apex:panelGrid>
            <apex:panelGrid columns="1">
                <apex:outputText value="{!spf.SPF_of_Heat_Pump_75F__c}" /> 
            </apex:panelGrid>
            <apex:panelGrid columns="1">
                <apex:outputText value="{!spf.SPF_of_Heat_Pump_70F__c}" />
            </apex:panelGrid>
            <apex:panelGrid columns="4" bgcolor="#660033" columnClasses="colStyle" width="100%">
                <div style="color:#FFFAF0;font-weight:bold;" > % Energy Savings</div>         
            </apex:panelGrid>
            <apex:panelGrid columns="1">       
                {!spf.Energy_Savings_65F__c}%
            </apex:panelGrid>
            <apex:panelGrid columns="1">
                {!spf.Energy_Savings_75F__c}%
            </apex:panelGrid>
            <apex:panelGrid columns="1">
                {!spf.Energy_Savings_70F__c}%
            </apex:panelGrid>
        </apex:panelGrid>
    </apex:pageBlock> 
    <apex:pageBlock >
          <br/>
          <br/>
          <br/>
    </apex:pageBlock>
    <apex:pageBlock >
        <apex:panelGrid columns="2" width="100%" border="1" cellspacing="0" cellpadding="0">
            <apex:panelGrid columns="2" bgcolor="#660033" columnClasses="colStyle" width="100%">
                <div style="color:#FFFAF0;font-weight:bold;" > Heat Gain in BTUH</div>   
            </apex:panelGrid> 
            <apex:panelGrid columns="1" width="95px">
                <apex:outputText value="{!spf.Heat_Gain_in_BTUH__c}" />
            </apex:panelGrid>      
            <apex:panelGrid columns="2" bgcolor="#660033" columnClasses="colStyle" width="100%">
                <div style="color:#FFFAF0;font-weight:bold;" > Estimated Cooling KWHR Per Year (Hrs Above {!spf.Hours_Above_75_70_or_80__c}&#176;F)</div>    
            </apex:panelGrid>
            <apex:panelGrid columns="1" width="95px">
                <apex:outputText value="{!spf.Estimated_Cooling_KWHR_Per_Year__c}" />
            </apex:panelGrid> 
            <apex:panelGrid columns="2" bgcolor="#660033" columnClasses="colStyle" width="100%">
                <div style="color:#FFFAF0;font-weight:bold;" > Estimated Cooling Costs at {!spf.Cooling_Cost_per_KWH_in_cents__c} Per KWHR</div> 
            </apex:panelGrid>      
            <apex:panelGrid columns="1" width="95px">
                <apex:outputText value="{!spf.Estimated_Cooling_Costs__c}" />
            </apex:panelGrid>
        </apex:panelGrid>
    </apex:pageBlock>
          <br/>
          <br/>
          <br/>
          <br/>
    <apex:pageBlock >
        <apex:panelGrid columns="5" width="100%" border="1"  cellspacing="0" cellpadding="0">
            <apex:panelGrid columns="1" bgcolor="#660033" width="100%" cellspacing="25" cellpadding="25">                          
            </apex:panelGrid>
            <apex:panelGrid columns="1">
                <hd> <b>KiloWatt Hours</b> </hd>     
            </apex:panelGrid>
            <apex:panelGrid columns="1"> 
                <hd> <b>PTAC</b> </hd>           
            </apex:panelGrid>     
            <apex:panelGrid columns="1">
                <hd> <b>KiloWatt Hours</b> </hd>  
            </apex:panelGrid>
            <apex:panelGrid columns="1">
                <hd> <b>PTHP</b> </hd>  
            </apex:panelGrid>
            <apex:panelGrid columns="5" bgcolor="#660033" columnClasses="colStyle" width="100%">
                <div style="color:#FFFAF0;font-weight:bold;" > Total KWHR Per Year</div> 
            </apex:panelGrid> 
            <apex:panelGrid columns="1">       
                <apex:outputText value="{!spf.Total_KWHR_Per_Year__c}" />
            </apex:panelGrid>
            <apex:panelGrid columns="1">
                <apex:outputText value="{!spf.Total_KWHR_Per_YearPTAC__c}" /> 
            </apex:panelGrid>
            <apex:panelGrid columns="1">
                <apex:outputText value="{!spf.Total_KWHR_Per_YearKilowattHr__c}" />
            </apex:panelGrid>
            <apex:panelGrid columns="1">
                <apex:outputText value="{!spf.Total_KWHR_Per_YearPTHP__c}" />
            </apex:panelGrid>
            <apex:panelGrid columns="5" bgcolor="#660033" columnClasses="colStyle" width="100%">
                <div style="color:#FFFAF0;font-weight:bold;" > % of Energy For Cooling</div>       
            </apex:panelGrid>
            <apex:panelGrid columns="1">                   
                <apex:outputText value="{!spf.Energy_For_Cooling__c}" /> 
            </apex:panelGrid>
            <apex:panelGrid columns="1">
                {!spf.Energy_For_Cooling_PTAC__c}%
            </apex:panelGrid>
            <apex:panelGrid columns="1">
                <apex:outputText value="{!spf.Energy_For_Cooling_KiloWatt_Hrs__c}" />
            </apex:panelGrid>
            <apex:panelGrid columns="1">
                {!spf.Energy_For_Cooling_PTHP__c}%
            </apex:panelGrid>
            <apex:panelGrid columns="5" bgcolor="#660033" columnClasses="colStyle" width="100%">
                <div style="color:#FFFAF0;font-weight:bold;" > % of Energy For Heating</div>             
            </apex:panelGrid>
            <apex:panelGrid columns="1">
                <apex:outputText value="{!spf.Energy_For_Heating__c}" /> 
            </apex:panelGrid>
            <apex:panelGrid columns="1">
                <apex:outputField value="{!spf.Energy_For_Heating_PTAC__c}" /> 
            </apex:panelGrid>
            <apex:panelGrid columns="1">       
                <apex:outputText value="{!spf.Energy_For_Heating_KiloWatt_Hrs__c}" />
            </apex:panelGrid>
            <apex:panelGrid columns="1"> 
                <apex:outputField value="{!spf.Energy_For_Heating_PTHP__c} " /> 
            </apex:panelGrid>
        </apex:panelGrid>
    </apex:pageBlock>
