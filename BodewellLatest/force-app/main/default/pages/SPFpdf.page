            </apex:panelGrid>
            <apex:panelGrid columns="1" width="205px">
                <apex:outputText value="{!spf.Annual_KWH_Required_For_Heat_Pump_Sys_HP__c }" />
            </apex:panelGrid>
            <apex:panelGrid columns="2" bgcolor="#660033" columnClasses="colStyle" width="100%">
                <div style="color:#FFFAF0;font-weight:bold;" > Annual KWH Savings</div>         
            </apex:panelGrid>
            <apex:panelGrid columns="1" width="205px">
                <apex:outputText value="{!spf.Annual_KWH_Savings__c}" />
