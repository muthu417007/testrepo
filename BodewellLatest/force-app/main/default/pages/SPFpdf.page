<!-- SPF Detail Page -->
    <body> 
    <apex:pageBlock >
        <apex:panelGrid columns="2" width="46%" border="1" cellspacing="0" cellpadding="0">
            <apex:panelGrid columns="2"  columnClasses="colStyle" width="100%">
                <!--<apex:outputText value="JobName :" />  -->    
                <apex:outputText value="JobName :" />  
            </apex:panelGrid>
            <apex:panelGrid columns="1" width="100%">       
                <apex:outputText value="{!spf.Job_Name__c}" />
            </apex:panelGrid>
            <apex:panelGrid columns="2"  columnClasses="colStyle" width="100%">
                <apex:outputText value=" Model :" />          
            </apex:panelGrid>
            <apex:panelGrid columns="1" width="100%">
                <apex:outputText value="{!spf.Model_Number__c}" />
            </apex:panelGrid>
            <apex:panelGrid columns="2"  columnClasses="colStyle" width="100%">
              <apex:outputText value="City & State :" />        
            </apex:panelGrid>
            <apex:panelGrid columns="1" width="100%">
                <apex:outputText value="{!spf.City_and_state__c}" />
            </apex:panelGrid>
        </apex:panelGrid>
    </apex:pageBlock> 
    <br/>
    <apex:pageBlock >
        <apex:panelGrid columns="3" width="100%" border="1" cellspacing="0" cellpadding="0">
            <apex:panelGrid columns="3"  bgcolor="#660033" columnClasses="colStyle" width="100%" headerClass="Title">
                <div style="color:#FFFAF0;font-weight:bold;" > Heating Data </div>
            </apex:panelGrid>     
            <apex:panelGrid columns="3" bgcolor="#660033"  columnClasses="colStyle" width="100%">
                <div style="color:#FFFAF0;font-weight:bold;" > Cooling Data</div>
            </apex:panelGrid>
            <apex:panelGrid columns="3" bgcolor="#660033"  columnClasses="colStyle" width="100%">
                <div style="color:#FFFAF0;font-weight:bold;" > Payback Information</div>
            </apex:panelGrid>
            <apex:panelGrid columns="3" width="100%">
                Indoor Temp.(F):&nbsp;&nbsp;&nbsp;&nbsp;{!spf.Indoor_Design_Temperature__c}
            </apex:panelGrid>    
            <apex:panelGrid columns="3">              
                Cooling Cost per KWH (in cents): <apex:outputText value="{!spf.Cooling_Cost_per_KWH_in_cents__c}" /> 
            </apex:panelGrid>
            <apex:panelGrid columns="3">
                <apex:outputText styleClass="fieldLabel" value="Heat Pump initial cost over resist.heat unit($)" />
            <apex:outputText value="{!spf.Heat_Pump_initial_cost_over_resist_heat__c}" />
            </apex:panelGrid>
            <apex:panelGrid columns="3">
                <apex:outputText styleClass="fieldLabel" value="Outdoor Temp.(F):" />
            <apex:outputText value="{!spf.Out_Door_design_Temperature__c}" />
            </apex:panelGrid>
            <apex:panelGrid columns="3">
                <apex:outputText styleClass="fieldLabel" value="Hours Above (75,70,or 80):" />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            <apex:outputText value="{!spf.Hours_Above_75_70_or_80__c}" /> 
            </apex:panelGrid>
            <apex:panelGrid columns="3">
                <apex:outputText styleClass="fieldLabel" value="Electricity cost per KWH(in cents):" />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                <apex:outputText value="{!spf.Electricity_cost_per_KWH_in_cents__c}" />
            </apex:panelGrid>
            <apex:panelGrid columns="3">
                <apex:outputText styleClass="fieldLabel" value="Heat Loss (Watts):" />
            <apex:outputText value="{!spf.Heat_Loss__c}" />
            </apex:panelGrid>
            <apex:panelGrid columns="3">
                <apex:outputText styleClass="fieldLabel" value="Heat gain (BTUH):" />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                <apex:outputText value="{!spf.Heat_gain_BTUH__c}" /> 
            </apex:panelGrid>
            <apex:panelGrid columns="3">
                <apex:outputText styleClass="fieldLabel" value="Drain line Installation Cost:" />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                <apex:outputText value="{!spf.Drain_line_Installation_Cost__c}" />
            </apex:panelGrid>
        </apex:panelGrid>
    </apex:pageBlock>   
    <br/> 
<!-- Calculations based on Indoor Temperature(F) -->  
    <apex:pageBlock > 
        <hd> 
                <b>Calculations based on {!spf.Indoor_Design_Temperature__c}&#176;F Indoor Temperature</b>
        </hd> 
    <br/>
        <apex:pageblocktable value="{!spfCalclst }" var="fgh" width="100%" border="1">
               <apex:column headerValue="Outdoor Temp" value="{!fgh.Outdoor_Temp__c}" headerClass="Title"/>
               <apex:column headerValue="Heat Loss(Watts)" value="{!fgh.Heat_Loss_Watts_Formula__c}" headerClass="Title" />
               <apex:column headerValue="Heating Hours" value="{!fgh.Heating_Hours__c}" headerClass="Title" />
               <apex:column headerValue="PTAC Resistance Heating (KWH)" value="{!fgh.PTAC_Resistance_Heating_KWH__c}" headerClass="Title" />
               <apex:column headerValue="Additional Heat Required Heat/Hr (Watts)" value="{!fgh.Additional_Heat_Required_Heat_Hr_Watts__c}" headerClass="Title" />
               <apex:column headerValue="Coefficient of Performance" value="{!fgh.Coefficient_of_Performance__c}" headerClass="Title" />
               <apex:column headerValue="Heat Pump (Kwh)" value="{!fgh.Heat_Pump_Kwh__c}" headerClass="Title" />
        </apex:pageblocktable>   
        </apex:pageBlock> 
