        <hd><b>Incremental Costs</b>  <br/></hd>
    <apex:pageBlock >
        <apex:panelGrid columns="2" width="100%" border="1" cellspacing="0" cellpadding="0">
            <apex:panelGrid columns="2" bgcolor="#660033" columnClasses="colStyle" width="100%">
                <div style="color:#FFFAF0;font-weight:bold;" > Heat Pump Cost Over Comparable System</div>      
            </apex:panelGrid>
            <apex:panelGrid columns="1" width="185px">       
                <apex:outputText value="{!spf.Heat_Pump_Cost_Over_Comparable_System__c}" />
            </apex:panelGrid>
            <apex:panelGrid columns="2" bgcolor="#660033" columnClasses="colStyle" width="100%">
                <div style="color:#FFFAF0;font-weight:bold;" > Drain Line Cost Per Unit</div>      
            </apex:panelGrid>
            <apex:panelGrid columns="1" width="185px">
                <apex:outputText value="{!spf.Drain_Line_Cost_Per_Unit__c}" />
            </apex:panelGrid>
            <apex:panelGrid columns="2" bgcolor="#660033" columnClasses="colStyle" width="100%">
                <div style="color:#FFFAF0;font-weight:bold;" > Total Incremental Cost Per Unit</div>        
