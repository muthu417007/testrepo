     <br/>      
    <apex:pageBlock > 
        <apex:pageblocktable value="{!spfHeatPA}" var="cop" width="100%" border="1">
               <apex:column headerValue="Utility Cost Per KWHR" value="{!cop.Utility_Cost_Per_KWHR__c}" headerClass="Title"/>
               <apex:column headerValue="Total Annual Cost Resistance Heat" value="{!cop.Total_Annual_Cost_Resistance_Heat__c}" headerClass="Title"/>
               <apex:column headerValue="Total Annual Cost Heat Pump" value="{!cop.Total_Annual_Cost_Heat_Pump__c}" headerClass="Title"/>
               <apex:column headerValue="Annual Savings With Heat Pump" value="{!cop.Annual_Savings_With_Heat_Pump__c}" headerClass="Title"/>
               <apex:column headerValue="Years for Payback" value="{!cop.Years_for_Payback__c}" headerClass="Title"/>
        </apex:pageblocktable>
