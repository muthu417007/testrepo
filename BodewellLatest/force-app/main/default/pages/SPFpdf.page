    <body>
    <br/>
        <hd><b>Cooling Data</b></hd>
    <br/>
    <apex:pageBlock >
        <apex:panelGrid columns="2" width="100%" border="1" cellspacing="0" cellpadding="0">
            <apex:panelGrid columns="2" bgcolor="#660033" columnClasses="colStyle" width="100%">
                <div style="color:#FFFAF0;font-weight:bold;" > Hours Above (70'F,75'F,80'F)</div>          
            </apex:panelGrid>
            <apex:panelGrid columns="1" width="130px">       
                <apex:outputText value="{!spf.Hours_Above_70F_75F_80F__c}" />
            </apex:panelGrid>
            <apex:panelGrid columns="2" bgcolor="#660033" columnClasses="colStyle" width="100%">
                <div style="color:#FFFAF0;font-weight:bold;" > Heat Gain in BTUH</div>         
            </apex:panelGrid>
            <apex:panelGrid columns="1" width="130px">
                <apex:outputText value="{!spf.Heat_Gain_in_BTUH_HeatPump__c}" />
            </apex:panelGrid>
        </apex:panelGrid>
    </apex:pageBlock> 
    <br/>
        <hd> <b>Heating KWH Savings Per Unit Per Year</b>  <br/></hd>
    <apex:pageBlock >
        <apex:panelGrid columns="2" width="100%" border="1" cellspacing="0" cellpadding="0">
            <apex:panelGrid columns="2" bgcolor="#660033" columnClasses="colStyle" width="100%">
                <div style="color:#FFFAF0;font-weight:bold;" > Annual KWH Required For Resistance Heat</div>        
            </apex:panelGrid>
            <apex:panelGrid columns="1" width="205px">       
                <apex:outputText value="{!spf.Annual_KWH_Required_For_Resistance_Ht_HP__c}" />
            </apex:panelGrid>
            <apex:panelGrid columns="2" bgcolor="#660033" columnClasses="colStyle" width="100%">
